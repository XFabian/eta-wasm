

record Point {
    x, y : int 
}

record Point2 {
    x : int;
    y : int
}
createPoint(x : int , y : int) : Point {
    return Point(x, y)
}

swap(p : Point) {
    t : int = p.x
    p.x = p.y
    p.y = p.x
}

record Node {
    value : int 
    next : Node
}

nodeFun (n : Node) {
    a : int = n.next.value
    b : Point[];
    f : int = b[1].x
}