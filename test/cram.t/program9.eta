reverse(arr: int[]) {
    i: int = 0
    j: int = length(arr) - 1
    while i < j {
        arr[i], arr[j] = arr[j], arr[i]
        i = i + 1
        j = j - 1
    }
}

main(args: int[][]): int {
    a: int[] = {1, 2, 3, 4, 5}
    reverse(a)
    if a[0] != 5 | a[1] != 4 | a[2] != 3 | a[3] != 2 | a[4] != 1 {
        return 1
    }
    return 0
}
