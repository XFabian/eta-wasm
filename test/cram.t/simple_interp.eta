use io
use conv

parseExpr(expr: int[]): int {
    i: int = 0
    lhs_chars: int[] = {}
    while i < length(expr) {
        c: int = expr[i]
        if c == '+ | c == '- | c == '*' | c == '/' {
            break
        }
        lhs_chars = lhs_chars + {c}
        i = i + 1
    }

    op: int = expr[i]
    i = i + 1

    rhs_chars: int[] = {}
    while i < length(expr) {
        rhs_chars = rhs_chars + {expr[i]}
        i = i + 1
    }

    lhs: int, ok1: bool = parseInt(lhs_chars)
    rhs: int, ok2: bool = parseInt(rhs_chars)

    if !ok1 | !ok2 {
        return -99999 // error code
    }

    if op == '+' {
        return lhs + rhs
    } else if op == '-' {
        return lhs - rhs
    } else if op == '*' {
        return lhs * rhs
    } else {
        return lhs / rhs
    }
}

main(args: int[][]): int {
    test1: int[] = "3+4"
    test2: int[] = "10-7"
    test3: int[] = "6*2"
    test4: int[] = "12/3"

    r1: int = parseExpr(test1)
    r2: int = parseExpr(test2)
    r3: int = parseExpr(test3)
    r4: int = parseExpr(test4)

    if r1 != 7 | r2 != 3 | r3 != 12 | r4 != 4 {
        return 1
    }

    return 0
}