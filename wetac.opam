# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A compiler for the Eta programming language targeting WebAssembly"
description:
  "Wetac compiles Eta, a small imperative language with integers, booleans, arrays, records and multiple return values, to WebAssembly. It emits WAT, which can be assembled with wat2wasm. Includes a CFG-based optimization framework with dominators, dataflow analyses and constant propagation."
maintainer: ["Xaver Fabian <xaver.fabian@gmail.com>"]
authors: ["Xaver Fabian"]
license: "MIT"
tags: ["compiler" "webassembly" "wasm" "eta" "ocaml"]
homepage: "https://github.com/xaver-fabian/wetac"
bug-reports: "https://github.com/xaver-fabian/wetac/issues"
depends: [
  "ocaml"
  "dune" {>= "3.16"}
  "menhir" {>= "20180523"}
  "cmdliner"
  "sexplib"
  "ppx_deriving"
  "ppx_sexp_conv"
  "expect_test_helpers_core"
  "ppx_expect"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/xaver-fabian/wetac.git"
